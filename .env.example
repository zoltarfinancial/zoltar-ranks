# Copy to .env and fill in. .env is gitignored and must never be committed,
# printed into logs, written into data/results/, or included in a commit message.
#
# Load it with python-dotenv in whichever provider needs it:
#     from dotenv import load_dotenv; load_dotenv()

# --- Robinhood (robin_stocks) -------------------------------------------
# Primary provider: the same source the ranks are built from, so it is the one
# that can reconcile against ranks.close_price. Robinhood requires interactive
# MFA on first login; robin_stocks caches a session token afterward, which is
# why the scheduled task can run unattended once you have logged in manually.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_SECRET=

# --- Alpaca --------------------------------------------------------------
# Secondary, for minute bars. Known to have gaps for some Robinhood-listed
# tickers - the Coverage object in sources/prices.py is mandatory, not optional.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets

# --- yfinance ------------------------------------------------------------
# No credentials needed. Cross-check only: 1-minute bars go back ~30 days.
